          example: 1
          minimum: 1
        pageSize:
          type: integer
          format: int32
          description: 每页大小
          example: 20
          minimum: 1
        orderBy:
          type: string
          description: 排序字段
          example: updateTime
        orderDirection:
          type: string
          description: 排序方向
          enum:
            - ASC
            - DESC
          example: DESC
