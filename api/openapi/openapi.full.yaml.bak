components:
  schemas:
    UserTransferSettingEditCmd:
      type: object
      properties:
        downloadLocation:
          type: string
          minLength: 1
        isDefaultDownloadLocation:
          type: integer
          format: int32
          maximum: 1
          minimum: 0
        downloadSpeedLimit:
          type: integer
          format: int32
          maximum: 200
        concurrentUploadQuantity:
          type: integer
          format: int32
          maximum: 3
        concurrentDownloadQuantity:
          type: integer
          format: int32
          maximum: 3
        chunkSize:
          type: integer
          format: int64
      required:
        - chunkSize
        - concurrentDownloadQuantity
        - concurrentUploadQuantity
        - downloadLocation
        - downloadSpeedLimit
        - isDefaultDownloadLocation
    ResultSysUserTransferSetting:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/SysUserTransferSetting"
        code:
          type: integer
          format: int32
        msg:
          type: string
    SysUserTransferSetting:
      type: object
      properties:
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
        id:
          type: integer
          format: int64
        userId:
          type: string
        downloadLocation:
          type: string
        isDefaultDownloadLocation:
          type: integer
          format: int32
        downloadSpeedLimit:
          type: integer
          format: int32
        concurrentUploadQuantity:
          type: integer
          format: int32
        concurrentDownloadQuantity:
          type: integer
          format: int32
        chunkSize:
          type: integer
          format: int64
    PasswordEditCmd:
      type: object
      properties:
        oldPassword:
          type: string
          minLength: 1
        newPassword:
          type: string
          minLength: 1
        confirmPassword:
          type: string
          minLength: 1
      required:
        - confirmPassword
        - newPassword
        - oldPassword
    ResultObject:
      type: object
      properties:
        data: {}
        code:
          type: integer
          format: int32
        msg:
          type: string
    UserEditInfoCmd:
      type: object
      properties:
        nickname:
          type: string
          minLength: 1
      required:
        - nickname
    PasswordForgetEditCmd:
      type: object
      properties:
        mail:
          type: string
          minLength: 1
        code:
          type: string
          minLength: 1
        newPassword:
          type: string
          minLength: 1
        confirmPassword:
          type: string
          minLength: 1
      required:
        - code
        - confirmPassword
        - mail
        - newPassword
    StorageSettingEditCmd:
      type: object
      properties:
        settingId:
          type: string
          minLength: 1
        platformIdentifier:
          type: string
          minLength: 1
        configData:
          type: string
          minLength: 1
        remark:
          type: string
      required:
        - configData
        - platformIdentifier
        - settingId
    ResultStorageSetting:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/StorageSetting"
        code:
          type: integer
          format: int32
        msg:
          type: string
    StorageSetting:
      type: object
      properties:
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
        id:
          type: string
        platformIdentifier:
          type: string
        configData:
          type: string
        enabled:
          type: integer
          format: int32
        userId:
          type: string
        remark:
          type: string
        deleted:
          type: integer
          format: int32
    SubscriptionPlanEditCmd:
      type: object
      properties:
        id:
          type: integer
          format: int64
        planCode:
          type: string
          minLength: 1
        planName:
          type: string
          minLength: 1
        description:
          type: string
        storageQuotaGb:
          type: integer
          format: int32
        maxFiles:
          type: integer
          format: int32
        maxFileSize:
          type: integer
          format: int64
        bandwidthQuota:
          type: integer
          format: int64
        price:
          type: number
          format: double
        isActive:
          type: integer
          format: int32
          maximum: 1
          minimum: 0
        isDefault:
          type: integer
          format: int32
          maximum: 1
          minimum: 0
        sortOrder:
          type: integer
          format: int32
      required:
        - bandwidthQuota
        - id
        - isActive
        - isDefault
        - maxFileSize
        - maxFiles
        - planCode
        - planName
        - price
        - sortOrder
        - storageQuotaGb
    RenameFileCmd:
      type: object
      properties:
        displayName:
          type: string
          minLength: 1
      required:
        - displayName
    MoveFileCmd:
      type: object
      properties:
        dirId:
          type: string
        fileIds:
          type: array
          items:
            type: string
          minItems: 1
      required:
        - fileIds
    ResultString:
      type: object
      properties:
        data:
          type: string
        code:
          type: integer
          format: int32
        msg:
          type: string
    UserRegisterCmd:
      type: object
      properties:
        username:
          type: string
          minLength: 1
        password:
          type: string
          minLength: 1
        confirmPassword:
          type: string
          minLength: 1
        email:
          type: string
          minLength: 1
        nickname:
          type: string
          minLength: 1
        avatar:
          type: string
      required:
        - confirmPassword
        - email
        - nickname
        - password
        - username
    ResultVoid:
      type: object
      properties:
        data: {}
        code:
          type: integer
          format: int32
        msg:
          type: string
    InitUploadCmd:
      type: object
      properties:
        fileName:
          type: string
          minLength: 1
        fileSize:
          type: integer
          format: int64
        parentId:
          type: string
        totalChunks:
          type: integer
          format: int32
        chunkSize:
          type: integer
          format: int64
        mimeType:
          type: string
          minLength: 1
      required:
        - chunkSize
        - fileName
        - fileSize
        - mimeType
        - totalChunks
    InitDownloadCmd:
      type: object
      properties:
        fileId:
          type: string
          minLength: 1
        chunkSize:
          type: integer
          format: int64
      required:
        - fileId
    InitDownloadResultVO:
      type: object
      properties:
        taskId:
          type: string
        fileName:
          type: string
        fileSize:
          type: integer
          format: int64
        totalChunks:
          type: integer
          format: int32
        chunkSize:
          type: integer
          format: int64
        downloadedChunks:
          type: array
          items:
            type: integer
            format: int32
          uniqueItems: true
    ResultInitDownloadResultVO:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/InitDownloadResultVO"
        code:
          type: integer
          format: int32
        msg:
          type: string
    CheckUploadCmd:
      type: object
      properties:
        taskId:
          type: string
          minLength: 1
        fileMd5:
          type: string
          minLength: 1
        fileName:
          type: string
      required:
        - fileMd5
        - taskId
    CheckUploadResultVO:
      type: object
      properties:
        isQuickUpload:
          type: boolean
        fileId:
          type: string
        taskId:
          type: string
        uploadId:
          type: string
        message:
          type: string
    ResultCheckUploadResultVO:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/CheckUploadResultVO"
        code:
          type: integer
          format: int32
        msg:
          type: string
    StorageSettingAddCmd:
      type: object
      properties:
        platformIdentifier:
          type: string
          minLength: 1
        configData:
          type: string
          minLength: 1
        remark:
          type: string
      required:
        - configData
        - platformIdentifier
    VerifyShareCodeCmd:
      type: object
      properties:
        shareId:
          type: string
          minLength: 1
        shareCode:
          type: string
          minLength: 1
      required:
        - shareCode
        - shareId
    ResultBoolean:
      type: object
      properties:
        data:
          type: boolean
        code:
          type: integer
          format: int32
        msg:
          type: string
    CreateShareCmd:
      type: object
      properties:
        fileIds:
          type: array
          items:
            type: string
          minItems: 1
        shareName:
          type: string
        expireType:
          type: integer
          format: int32
        expireTime:
          type: string
          format: date-time
        scope:
          type: string
        needShareCode:
          type: boolean
        maxViewCount:
          type: integer
          format: int32
        maxDownloadCount:
          type: integer
          format: int32
      required:
        - fileIds
    FileShareVO:
      type: object
      properties:
        id:
          type: string
        shareName:
          type: string
        shareCode:
          type: string
        expireTime:
          type: string
          format: date-time
        scope:
          type: string
        isPermanent:
          type: boolean
        viewCount:
          type: integer
          format: int32
        downloadCount:
          type: integer
          format: int32
        maxViewCount:
          type: integer
          format: int32
        maxDownloadCount:
          type: integer
          format: int32
        fileCount:
          type: integer
          format: int64
        createdAt:
          type: string
          format: date-time
    ResultFileShareVO:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/FileShareVO"
        code:
          type: integer
          format: int32
        msg:
          type: string
    SubscriptionPlanAddCmd:
      type: object
      properties:
        planCode:
          type: string
          minLength: 1
        planName:
          type: string
          minLength: 1
        description:
          type: string
        storageQuotaGb:
          type: integer
          format: int32
        maxFiles:
          type: integer
          format: int32
        maxFileSize:
          type: integer
          format: int64
        bandwidthQuota:
          type: integer
          format: int64
        price:
          type: number
          format: double
        isActive:
          type: integer
          format: int32
          maximum: 1
          minimum: 0
        isDefault:
          type: integer
          format: int32
          maximum: 1
          minimum: 0
        sortOrder:
          type: integer
          format: int32
      required:
        - bandwidthQuota
        - isActive
        - isDefault
        - maxFileSize
        - maxFiles
        - planCode
        - planName
        - price
        - sortOrder
        - storageQuotaGb
    CreateDirectoryCmd:
      type: object
      properties:
        folderName:
          type: string
          minLength: 1
          title: 目录名称
        parentId:
          type: string
          title: 父目录ID
      required:
        - folderName
    FileInfo:
      type: object
      properties:
        id:
          type: string
        objectKey:
          type: string
        originalName:
          type: string
        displayName:
          type: string
        suffix:
          type: string
        size:
          type: integer
          format: int64
        mimeType:
          type: string
        isDir:
          type: boolean
        parentId:
          type: string
        userId:
          type: string
        contentMd5:
          type: string
        storagePlatformSettingId:
          type: string
        uploadTime:
          type: string
          format: date-time
        updateTime:
          type: string
          format: date-time
        lastAccessTime:
          type: string
          format: date-time
        isDeleted:
          type: boolean
        deletedTime:
          type: string
          format: date-time
    ResultFileInfo:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/FileInfo"
        code:
          type: integer
          format: int32
        msg:
          type: string
    LoginCmd:
      type: object
      properties:
        username:
          type: string
          minLength: 1
        password:
          type: string
          minLength: 1
        isRemember:
          type: boolean
      required:
        - password
        - username
    ResultSysUserVO:
      type: object
      properties:
        data:
          $ref: "#/components/schemas/SysUserVO"
        code:
          type: integer
          format: int32
        msg:
          type: string
    SysUserVO:
      type: object
      description: 用户
      properties:
        id:
          type: string
          description: id
        username:
          type: string
          description: 用户名
        nickname:
          type: string
          description: 昵称
        avatar:
          type: string
          description: 头像
        email:
          type: string
          description: 邮箱地址
        status:
          type: integer
          format: int32
          description: 状态
        createdAt:
          type: string
          format: date-time
          description: 创建时间
        updatedAt:
          type: string
          format: date-time
          description: 更新时间
        lastLoginAt:
          type: string
          format: date-time
          description: 最后登录时间
    SseEmitter:
      type: object
      properties:
        timeout:
          type: integer
          format: int64
    TransferFilesQry:
      type: object
      properties:
        statusType:
          type: integer
          format: int32
    FileTransferTaskVO:
      type: object
      properties:
        taskId:
          type: string
        taskType:
          type: string
          enum:
            - upload
            - download
        userId:
          type: string
        parentId:
          type: string
        objectKey:
          type: string
        fileName:
          type: string
        fileSize:
          type: integer
          format: int64
        suffix:
          type: string
        totalChunks:
          type: integer
          format: int32
        uploadedChunks:
          type: integer
          format: int32
        chunkSize:
          type: integer
          format: int64
        storagePlatformSettingId:
          type: string
        status:
          type: string
          enum:
            - initialized
            - checking
            - uploading
            - merging
            - downloading
            - failed
            - paused
            - completed
            - canceled
        errorMsg:
          type: string
        startTime:
          type: string
          format: date-time
        completeTime:
          type: string
          format: date-time
        progress:
          type: integer
          format: int32
        speed:
          type: integer
          format: int64
        remainTime:
          type: integer
          format: int32
        uploadedSize:
          type: integer
          format: int64
        completeEventData: {}
    ResultListFileTransferTaskVO:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: "#/components/schemas/FileTransferTaskVO"
        code:
          type: integer
          format: int32
        msg:
          type: string
    ResultSetInteger:
      type: object
      properties:
        data:
          type: array
          items:
            type: integer
            format: int32
          uniqueItems: true
        code:
          type: integer
          format: int32
        msg:
          type: string
    DownloadChunkQry:
      type: object
      description: 下载分片查询参数
      properties:
        taskId:
          type: string
          description: 任务ID
          example: task123
          minLength: 1
        chunkIndex:
          type: integer
          format: int32
          description: 分片索引（从0开始）
          example: 0
          minimum: 0
      required:
        - chunkIndex
        - taskId
    StreamingResponseBody: {}
    ResultListStoragePlatformVO:
      type: object
      properties:
        data:
          type: array
          items:
            $ref: "#/components/schemas/StoragePlatformVO"
        code:
          type: integer
          format: int32
