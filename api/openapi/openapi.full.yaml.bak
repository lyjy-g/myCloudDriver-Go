openapi: 3.1.0
info:
  title: Free Fs API
  description: Free Fs API文档
  license:
    name: Apache 2.0
    url: https://gitee.com/dromara/free-fs/blob/master/LICENSE
  version: v2.1.2
externalDocs:
  description: 项目文档
  url: https://free-fs.top
servers:
  - url: http://localhost:8080
    description: Generated server url
security:
  - BearerAuth: []
tags:
  - name: 文件传输
    description: 文件传输
  - name: 文件管理
    description: 文件上传、下载、管理等接口
  - name: 文件分享
    description: 文件分享
  - name: 文件首页
    description: 首页
paths:
  /apis/user/transfer/setting:
    get:
      tags:
        - 用户管理
      summary: 获取用户传输配置
      operationId: sendForgetPasswordCode
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultSysUserTransferSetting"
    put:
      tags:
        - 用户管理
      summary: 修改用户传输配置
      operationId: updateUserTransferSetting
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UserTransferSettingEditCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultSysUserTransferSetting"
  /apis/user/password:
    put:
      tags:
        - 用户管理
      summary: 修改密码
      operationId: resetPassword
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PasswordEditCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/user/info:
    get:
      tags:
        - 用户管理
      summary: 获取用户详细信息
      operationId: getDetail
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultSysUserVO"
    put:
      tags:
        - 用户管理
      summary: 编辑用户
      operationId: editUserInfo
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UserEditInfoCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/user/forget-password:
    put:
      tags:
        - 用户管理
      summary: 忘记密码-修改密码
      operationId: checkForgetPasswordCode
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PasswordForgetEditCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/storage/settings:
    put:
      tags:
        - 存储平台管理
      summary: 新增存储平台配置
      operationId: saveOrUpdateStorageSetting_1
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StorageSettingEditCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultStorageSetting"
    post:
      tags:
        - 存储平台管理
      summary: 新增存储平台配置
      operationId: saveOrUpdateStorageSetting
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StorageSettingAddCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultStorageSetting"
  /apis/plan:
    put:
      tags:
        - 套餐管理
      summary: 编辑套餐
      operationId: edit
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SubscriptionPlanEditCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
    post:
      tags:
        - 套餐管理
      summary: 添加套餐
      operationId: add
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SubscriptionPlanAddCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/file/{fileId}/rename:
    put:
      tags:
        - 文件管理
      summary: 文件重命名
      description: 文件重命名
      operationId: createDirectory
      parameters:
        - name: fileId
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/RenameFileCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/file/recycles:
    put:
      tags:
        - 文件管理
      summary: 恢复文件
      description: 从回收站批量恢复文件
      operationId: restoreFile
      requestBody:
        content:
          application/json:
            schema:
              type: array
              items:
                type: string
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
    delete:
      tags:
        - 文件管理
      summary: 永久删除文件
      description: 永久删除文件，不可恢复
      operationId: permanentlyDeleteFiles
      requestBody:
        content:
          application/json:
            schema:
              type: array
              items:
                type: string
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/file/moves:
    put:
      tags:
        - 文件管理
      summary: 文件移动
      description: 文件移动
      operationId: createDirectory_1
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/MoveFileCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /preview/token/{fileId}:
    post:
      tags:
        - file-preview-controller
      operationId: previewToken
      parameters:
        - name: fileId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultString"
  /archive/preview/token/{archiveFileId}:
    post:
      tags:
        - archive-preview-controller
      operationId: previewToken_1
      parameters:
        - name: archiveFileId
          in: path
          required: true
          schema:
            type: string
        - name: innerPath
          in: query
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultString"
  /apis/user/register:
    post:
      tags:
        - 用户管理
      summary: 注册用户
      operationId: register
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UserRegisterCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/transfer/resume/{taskId}:
    post:
      tags:
        - 文件传输
      summary: 继续传输
      operationId: resumeTransfer
      parameters:
        - name: taskId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultVoid"
  /apis/transfer/pause/{taskId}:
    post:
      tags:
        - 文件传输
      summary: 暂停传输
      operationId: pauseTransfer
      parameters:
        - name: taskId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultVoid"
  /apis/transfer/merge/{taskId}:
    post:
      tags:
        - 文件传输
      summary: 合并分片
      description: 所有分片上传完成后调用，合并分片并返回文件ID
      operationId: mergeChunks
      parameters:
        - name: taskId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultString"
  /apis/transfer/init:
    post:
      tags:
        - 文件传输
      summary: 初始化文件上传
      description: 初始化上传环境，返回taskId用于后续分片上传
      operationId: initUpload
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/InitUploadCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultString"
  /apis/transfer/init-download:
    post:
      tags:
        - 文件传输
      summary: 初始化下载任务
      description: 创建下载任务并返回任务信息
      operationId: initDownload
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/InitDownloadCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultInitDownloadResultVO"
  /apis/transfer/chunk:
    post:
      tags:
        - 文件传输
      summary: 上传分片
      description: 异步上传分片，立即返回，通过SSE推送进度
      operationId: uploadChunk
      parameters:
        - name: taskId
          in: query
          required: true
          schema:
            type: string
        - name: chunkIndex
          in: query
          required: true
          schema:
            type: integer
            format: int32
        - name: chunkMd5
          in: query
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                file:
                  type: string
                  format: binary
              required:
                - file
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/transfer/check:
    post:
      tags:
        - 文件传输
      summary: 校验文件
      description: 前端计算完MD5后调用，判断是否秒传
      operationId: checkUpload
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CheckUploadCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultCheckUploadResultVO"
  /apis/storage/settings/{id}/{action}:
    post:
      tags:
        - 存储平台管理
      summary: 启用或禁用存储平台
      operationId: enableOrDisableStoragePlatform
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
        - name: action
          in: path
          required: true
          schema:
            type: integer
            format: int32
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultStorageSetting"
  /apis/share/verify/code:
    post:
      tags:
        - 文件分享
      summary: 验证提取码
      description: 验证提取码
      operationId: verifyShareCode
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/VerifyShareCodeCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultBoolean"
  /apis/share/create:
    post:
      tags:
        - 文件分享
      summary: 创建分享
      description: 创建分享
      operationId: createDirectory_2
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateShareCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultFileShareVO"
  /apis/file/favorites:
    post:
      tags:
        - 文件管理
      summary: 收藏文件
      description: 收藏文件
      operationId: favoritesFile
      requestBody:
        content:
          application/json:
            schema:
              type: array
              items:
                type: string
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
    delete:
      tags:
        - 文件管理
      summary: 取消收藏文件
      description: 取消收藏文件
      operationId: unFavoritesFile
      requestBody:
        content:
          application/json:
            schema:
              type: array
              items:
                type: string
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/file/directory:
    post:
      tags:
        - 文件管理
      summary: 创建目录
      description: 在指定目录下创建新目录
      operationId: createDirectory_3
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateDirectoryCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultFileInfo"
  /apis/auth/logout:
    post:
      tags:
        - 认证管理
      summary: 登出
      operationId: logout
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/auth/login:
    post:
      tags:
        - 认证管理
      summary: 登录
      operationId: doLogin
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginCmd"
        required: true
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/user/forget-password/code/{mail}:
    get:
      tags:
        - 用户管理
      summary: 忘记密码-发送验证码
      operationId: sendForgetPasswordCode_1
      parameters:
        - name: mail
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultObject"
  /apis/transfer/sse:
    get:
      tags:
        - 文件传输
      summary: 建立SSE连接
      description: 建立SSE连接以接收实时传输事件
      operationId: subscribe
      parameters:
        - name: userId
          in: query
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/SseEmitter"
  /apis/transfer/files:
    get:
      tags:
        - 文件传输
      summary: 获取传输列表
      description: 获取传输列表
      operationId: getTransferFiles
      parameters:
        - name: qry
          in: query
          required: true
          schema:
            $ref: "#/components/schemas/TransferFilesQry"
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListFileTransferTaskVO"
  /apis/transfer/download/{fileId}:
    get:
      tags:
        - 文件传输
      summary: 下载文件
      description: 根据文件ID下载文件
      operationId: downloadFile
      parameters:
        - name: fileId
          in: path
          description: 文件ID
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                type: string
                format: binary
  /apis/transfer/download/chunks/{taskId}:
    get:
      tags:
        - 文件传输
      summary: 查询已下载分片
      description: 获取已下载的分片索引列表
      operationId: getDownloadedChunks
      parameters:
        - name: taskId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultSetInteger"
  /apis/transfer/download/chunk:
    get:
      tags:
        - 文件传输
      summary: 下载分片
      description: 下载指定分片，返回206 Partial Content
      operationId: downloadChunk
      parameters:
        - name: qry
          in: query
          required: true
          schema:
            $ref: "#/components/schemas/DownloadChunkQry"
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/StreamingResponseBody"
  /apis/transfer/chunks/{taskId}:
    get:
      tags:
        - 文件传输
      summary: 查询已上传的分片
      description: 用于断点续传，返回已上传的分片索引列表
      operationId: getUploadedChunks
      parameters:
        - name: taskId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultSetInteger"
  /apis/storage/platforms:
    get:
      tags:
        - 存储平台管理
      summary: 获取存储平台列表
      operationId: getPlatforms
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListStoragePlatformVO"
  /apis/storage/platform/{identifier}:
    get:
      tags:
        - 存储平台管理
      summary: 根据标识符获取存储平台详情
      operationId: getStoragePlatformByIdentifier
      parameters:
        - name: identifier
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultStoragePlatform"
  /apis/storage/platform/settings:
    get:
      tags:
        - 存储平台管理
      summary: 获取用户存储平台配置列表
      operationId: getStorageSettingsByUser
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListStorageSettingUserVO"
  /apis/storage/active-platforms:
    get:
      tags:
        - 存储平台管理
      summary: 获取用户已启用存储平台列表
      operationId: getActiveStoragePlatforms
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListStorageActivePlatformsVO"
  /apis/share/{shareId}:
    get:
      tags:
        - 文件分享
      summary: 获取分享详细信息
      description: 获取分享详细信息
      operationId: getDetail_1
      parameters:
        - name: shareId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultFileShareVO"
  /apis/share/{shareId}/items:
    get:
      tags:
        - 文件分享
      summary: 获取分享页文件列表数据
      description: 获取分享页文件列表数据
      operationId: getShareFileItems
      parameters:
        - name: shareId
          in: path
          required: true
          schema:
            type: string
        - name: parentId
          in: query
          required: false
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListFileVO"
  /apis/share/{shareId}/info:
    get:
      tags:
        - 文件分享
      summary: 获取分享页数据
      description: 获取分享页数据
      operationId: getFileShareThin
      parameters:
        - name: shareId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultFileShareThinVO"
  /apis/share/{shareId}/download/{fileId}:
    get:
      tags:
        - 文件分享
      summary: 分享内文件下载
      description: 分享内文件下载
      operationId: downloadShareFile
      parameters:
        - name: shareId
          in: path
          required: true
          schema:
            type: string
        - name: fileId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                type: string
                format: binary
  /apis/share/{shareId}/access/records:
    get:
      tags:
        - 文件分享
      summary: 获取分享访问记录列表
      description: 获取分享访问记录列表
      operationId: getListByShareId
      parameters:
        - name: shareId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/ResultListFileShareAccessRecordVO"
  /apis/share/pages:
    get:
      tags:
        - 文件分享
      summary: 获取我的分享
      description: 分页获取我的分享列表
      operationId: getPages
      parameters:
        - name: qry
          in: query
          required: true
          schema:
            $ref: "#/components/schemas/FileShareQry"
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/PageResultFileShareVO"
  /apis/plan/pages:
    get:
      tags:
        - 套餐管理
      summary: 分页获取套餐列表
      operationId: getPages_1
      parameters:
        - name: qry
          in: query
          required: true
          schema:
            $ref: "#/components/schemas/SubscriptionPlanPageQry"
      responses:
        "200":
          description: OK
          content:
            '*/*':
              schema:
                $ref: "#/components/schemas/PageResultSubscriptionPlanVO"
  /apis/plan/info/{id}:
    get:
      tags:
        - 套餐管理
      summary: 获取套餐详细信息
